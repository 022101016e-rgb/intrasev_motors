#--------------------------------------------------------------------
# Ejemplo de .env para la copia de STAGING local (Guía 9, Paso 5)
# Copie este contenido a .env en la carpeta proyecto-staging y sustituya
# USUARIO_STAGING / CLAVE_STAGING. No publique el .env resultante.
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

app.baseURL = 'http://localhost:8081/'

database.default.hostname = localhost
database.default.database = ds_g1_staging
database.default.username = USUARIO_STAGING
database.default.password = CLAVE_STAGING
database.default.DBDriver = MySQLi
database.default.port = 3306
